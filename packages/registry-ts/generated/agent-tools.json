[
  {
    "name": "fno_contract_rules",
    "description": "F&O contract rules, expiry cycle weekdays, lot value and ban status",
    "input_schema": {
      "properties": {
        "exchange": {
          "title": "Exchange",
          "type": "string"
        },
        "underlying": {
          "title": "Underlying",
          "type": "string"
        },
        "on": {
          "format": "date",
          "title": "On",
          "type": "string"
        }
      },
      "required": [
        "exchange",
        "underlying",
        "on"
      ],
      "title": "FnoContractRulesInput",
      "type": "object"
    }
  },
  {
    "name": "instrument_lookup",
    "description": "Point-in-time instrument resolution, asset-class role and eligibility",
    "input_schema": {
      "properties": {
        "on": {
          "format": "date",
          "title": "On",
          "type": "string"
        },
        "symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol"
        },
        "instrument_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instrument Id"
        },
        "purpose": {
          "anyOf": [
            {
              "enum": [
                "basket_member",
                "order_draft_leg",
                "basket_tracking_member"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purpose"
        }
      },
      "required": [
        "on"
      ],
      "title": "InstrumentLookupInput",
      "type": "object"
    }
  },
  {
    "name": "runs_latest",
    "description": "Latest published run of a kind (for example the current regime)",
    "input_schema": {
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "LatestRunInput",
      "type": "object"
    }
  },
  {
    "name": "trading_calendar",
    "description": "Trading session status, holidays and adjacent sessions per segment",
    "input_schema": {
      "properties": {
        "segment": {
          "title": "Segment",
          "type": "string"
        },
        "on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "On"
        },
        "timestamp": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp"
        }
      },
      "required": [
        "segment"
      ],
      "title": "TradingCalendarInput",
      "type": "object"
    }
  }
]
